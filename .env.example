# Optional. Copy this file to ".env" (or run SetApiKey.bat) to unlock Premium AI tools:
# AI photo reading, AI explanations, and the ask-the-tutor box. Without a key the app is the
# free offline version: solver, offline OCR and 3D all still work.
# Fill in one or both keys. AI_PROVIDER picks which one to use: anthropic or gemini.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional Gemini model override (default gemini-3.8-flash). Leave empty unless Google retires that model.
GEMINI_MODEL=
